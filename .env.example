# Composio: https://platform.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=

# Toolkits the agent may use (comma-separated Composio slugs)
COMPOSIO_TOOLKITS=gmail,googledrive

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2024-10-21

# Web app sign-in (server.py)
# The address people open the app at. Composio sends them back here after Google sign-in.
# Leave empty when you only use it on this computer (http://127.0.0.1:8000).
PUBLIC_URL=
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your network can open it too.
HOST=127.0.0.1

# MySQL (stores users, sign-ins, conversations, notes and memory)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eod-automation

# Daily and monthly summaries (summaries.py)
# Nightly: after this hour (India time) each signed-in user's day is summarized and saved, if not done already.
DAILY_SUMMARY_HOUR=23
# false = only save summaries people ask for; months are still consolidated.
AUTO_DAILY_SUMMARIES=true
# off = no background job at all.
SUMMARY_SCHEDULER=on

# EOD reports (eod.py): always sent To these addresses (comma separated). The user's reporting manager goes in Cc.
EOD_RECIPIENTS=ranjitha@armstrong-cap.com,manju@armstrong-cap.com

# Database backend: mysql (default) or d1 (Cloudflare D1, used for testing; see d1.py and migrate_to_d1.py)
DB_BACKEND=mysql
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token with the permission Account / D1 / Edit
CLOUDFLARE_API_TOKEN=
